<Project Sdk="Aspire.AppHost.Sdk/13.5.2">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>1d69ee95-0175-4f06-b006-b515547ea961</UserSecretsId>
    <!-- Orchestration dependencies come from NuGet, not the CLI bundle. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" />
    <PackageReference Include="Aspire.Hosting.Azure.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../backend/encouragement-api/encouragement-api.csproj" />
    <ProjectReference Include="../backend/contacts-api/contacts-api.csproj" />
  </ItemGroup>

</Project>
