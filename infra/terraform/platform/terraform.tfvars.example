# Copy to terraform.tfvars (gitignored) and fill in.

# Tenant that owns the Microsoft 365 instance, and the subscription under it
# ("Subscription 1") that now holds all infrastructure.
tenant_id       = "aac88807-ec5d-4c7a-8379-0f2baf8123e0"
subscription_id = "20aad6af-afbd-4c72-a48d-59ae01ca2cb2"

location = "eastus2"

# Both are globally unique names -- change if taken. These are the live names; the
# migration's originals (kv-mynl-platform, stmynltokenstore) are retired, and Key Vault
# soft delete keeps a deleted vault's name reserved for its retention period, so do not
# reach for those.
key_vault_name           = "kv-mynl"
token_store_account_name = "stmynltokens"

# Empty on the first apply. After `aspire deploy` creates the dashboard
# Container App, fill in its system-assigned identity and re-apply:
#   az containerapp show -n dashboard -g <azd-rg> \
#     --query identity.principalId -o tsv
container_app_principal_ids = []

# From `terraform -chdir=../entra output -raw cicd_principal_id`, once the entra
# module has been applied with manage_github_actions = true. Grants the CI
# identity Contributor + User Access Administrator on the subscription.
cicd_principal_ids = []
